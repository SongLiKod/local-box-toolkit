{
  "name": "LocalBox",
  "appid": "",
  "description": "一站式本地工具箱：格式转换、开发工具、证件照、便民工具，文件不上传服务器",
  "versionName": "2.0.0",
  "versionCode": "20000",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "compatible": {
      "ignoreVersion": true
    },
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "minSdkVersion": 28,
        "targetSdkVersion": 33,
        "permissions": [
          "<uses-permission android:name=\"android.permission.READ_EXTERNAL_STORAGE\"/>",
          "<uses-permission android:name=\"android.permission.WRITE_EXTERNAL_STORAGE\"/>"
        ],
        "abiFilters": [
          "armeabi-v7a",
          "arm64-v8a"
        ]
      },
      "ios": {},
      "sdkConfigs": {},
      "extraAssetHints": {
        "compression": true
      }
    }
  },
  "quickapp": {},
  "vueVersion": "3",
  "uniStatistics": {
    "enable": false
  }
}
