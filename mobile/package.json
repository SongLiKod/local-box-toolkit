    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^5.0.0",
    "sass": "^1.77.6",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.8.27"
