    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "crypto-js": "^4.2.0",
    "docx-preview": "^0.4.1",
    "gifenc": "^1.0.3",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.11.6",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
