{
  "name": "localbox-electron",
  "version": "3.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "node scripts/prepare-renderer.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build && electron .",
    "dist": "node ../scripts/sync-version.mjs && npm run build && electron-builder",
    "dist:win": "node ../scripts/sync-version.mjs && npm run build && electron-builder --win",
    "dist:mac": "node ../scripts/sync-version.mjs && npm run build && electron-builder --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5"
  }
}
